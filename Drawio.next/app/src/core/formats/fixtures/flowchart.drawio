<mxfile host="drawio.next" version="1.0">
  <diagram id="d-flowchart" name="Flujo de Proceso">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="fc-start" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="40" width="100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="fc-step1" value="Validar Usuario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="190" y="140" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="fc-decision" value="¿Autorizado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="190" y="240" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="fc-success" value="Acceso Permitido" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="fc-end" value="Fin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="200" y="370" width="100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="fc-start" target="fc-step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="fc-step1" target="fc-decision">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-3" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="fc-decision" target="fc-success">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="fc-decision" target="fc-end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>